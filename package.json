{
  "name": "kumo",
  "productName": "Kumo",
  "version": "1.0.0",
  "description": "A quiet companion for your AI coding agents.",
  "author": "Liwidale",
  "license": "MIT",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "relay": "node scripts/relay.mjs",
    "start": "node scripts/build.mjs && electron .",
    "dev": "node scripts/build.mjs --dev && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pack:win": "node scripts/relay.mjs && node scripts/build.mjs && electron-builder --win --x64",
    "pack:mac": "node scripts/relay.mjs --universal && node scripts/koffi.mjs && node scripts/build.mjs && electron-builder --mac",
    "icons": "node scripts/icons.mjs",
    "test:mac": "node scripts/test-mac.mjs"
  },
  "dependencies": {
    "koffi": "^3.3.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "motion": "^13.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "zustand": "^5.0.15"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "koffi@3.3.2": true,
    "electron-winstaller@5.4.0": true,
    "electron@44.5.1": true
  }
}
